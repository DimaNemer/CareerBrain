# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local embedding model (fetched by scripts/download-embed-model.mjs)
/models/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# opencode config
.agents/
.opencode/

# graphify generated output
graphify-out/
.graphifyignore

# temp files
temp-opportunities.html
ersBadihOneDriveDesktopWebsiteProjectCareerBrainappopportunitiespage*

# env files (expand for all variants)
.env*
!.env.example

.env.example

# Supabase: keep the directory ignored by default, but DO track migrations.
# Without this, schema changes (company_invites, the accept_company_invite RPC,
# the last-owner trigger) never reach the deployed app and the team APIs break.
supabase/*
!supabase/migrations/
